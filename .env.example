# Path to the LinkedIn-exported PDF resume.
# Prefer forward slashes on Windows: PDF_PATH=C:/Users/you/resume.pdf
PDF_PATH=Profile.pdf

# Compile the generated .tex file when pdflatex or xelatex is installed.
COMPILE=false

# Optional Jinja LaTeX template. Leave empty to use data/templates/resume.tex.
TEMPLATE=

# Optional photo for data/templates/regyl_template.tex. Leave empty for no avatar.
# Prefer forward slashes. pdflatex accepts .jpg, .png, and .pdf.
# A square headshot looks best.
PHOTO_PATH=
